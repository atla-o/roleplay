{
  "name": "Gene Ark",
  "summary": "A catalog for a polar desert: pioneer films, cold-hardy cover, sheltered crops and timber, fauna, and the checks a settlement needs.",
  "modules": [
    { "id": "pioneer-film", "name": "Pioneer film", "intent": "First living cover on drained, frost-bound regolith." },
    { "id": "pioneer-crust", "name": "Pioneer crust", "intent": "Lichen and moss on stone that no longer holds a puddle." },
    { "id": "forb-cover", "name": "Forb cover", "intent": "Low flowering cover for the open growing window." },
    { "id": "shrub", "name": "Shrub", "intent": "Prostrate willow and avens, the woody layer this climate can carry in the open." },
    { "id": "shelter-crop", "name": "Shelter crop", "intent": "Calories inside a dome or greenhouse, paced to ninety days." },
    { "id": "shelter-timber", "name": "Shelter timber", "intent": "A boreal timber line kept inside the shelter. It does not pretend to stand in the open desert." },
    { "id": "soil-fauna", "name": "Soil fauna", "intent": "The small animals a living bed needs." },
    { "id": "open-fauna", "name": "Open fauna", "intent": "Fauna released only where cover is already established." },
    { "id": "settlement", "name": "Settlement readiness", "intent": "Water, calories, shelter, and a street that has been walked. Not a person to talk to." }
  ],
